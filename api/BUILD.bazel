load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "pricing_api",
    srcs = [
        "pricing_api.cpp",
        "short_rate_api.cpp",
    ],
    hdrs = [
        "pricing_api.h",
        "short_rate_api.h",
    ],
    deps = [
        "//derivatives:derivative",
        "//derivatives:hull_white_bond_option",
        "//derivatives:interest_rate_derivative",
        "//derivatives:vanilla_option",
        "//instruments/swaps:fixed_cashflow_instrument",

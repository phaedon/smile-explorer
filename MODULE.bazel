module(
    name = "smile-explorer",
)

bazel_dep(name = "abseil-cpp", version = "20260817.0")

# Required for GLFW support on MacOS.
bazel_dep(name = "apple_support", version = "2.11.0")

bazel_dep(name = "boost.math", version = "1.90.0.bcr.1")
bazel_dep(name = "csv-parser", version = "2.3.0")
bazel_dep(name = "eigen", version = "5.0.1.bcr.3")
bazel_dep(name = "emsdk", version = "6.0.13")
bazel_dep(name = "glfw", version = "3.4.0.bcr.4")
bazel_dep(name = "googletest", version = "1.18.0.bcr.1")
bazel_dep(name = "imgui", version = "1.91.8.bcr.1")
bazel_dep(name = "implot", version = "0.16")
bazel_dep(name = "implot3d", version = "0.2")
bazel_dep(name = "magic_enum", version = "0.9.8")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.27")

# On Windows, builds use clang-cl from the auto-configured C++ toolchains
# (see .bazelrc), which are only visible to this module through use_repo.
cc_configure = use_extension("@rules_cc//cc:extensions.bzl", "cc_configure_extension")
use_repo(cc_configure, "local_config_cc")

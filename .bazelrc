# Example for referencing a custom BCR branch:
#query --registry=https://raw.githubusercontent.com/phaedon/bazel-central-registry/implot3d
#build --registry=https://raw.githubusercontent.com/phaedon/bazel-central-registry/implot3d
# Flags per host OS: build:linux, build:macos and build:windows below.
common --enable_platform_specific_config

build:linux --cxxopt=-std=c++20 --cxxopt=-Werror=return-type --copt=-Wsign-compare
build:macos --cxxopt=-std=c++20 --cxxopt=-Werror=return-type --copt=-Wsign-compare

# Windows builds with clang-cl: the same Clang front end as on Linux and
# macOS, behind an MSVC-compatible driver, with the MSVC standard library and
# linker. It needs LLVM installed (found via BAZEL_LLVM, or in its default
# location), alongside Visual Studio or its Build Tools. Its flags are spelled
# the MSVC way (/std:c++20), but it understands Clang's warning flags.
build:windows --extra_toolchains=@local_config_cc//:cc-toolchain-x64_windows-clang-cl
build:windows --extra_execution_platforms=//:x64_windows-clang-cl
build:windows --cxxopt=/std:c++20 --host_cxxopt=/std:c++20
build:windows --cxxopt=-Werror=return-type --copt=-Wsign-compare
# Some comments aren't ASCII; and <windows.h>, pulled in by dependencies,
# would otherwise define min and max macros that break std::min/std::max.
build:windows --copt=/utf-8 --copt=/DNOMINMAX
# The toolchain defines _WIN32_WINNT as Windows 7 (0x0601) by default, and
# dependencies redefine it as Windows 10, warning on every file. Target
# Windows 10 from the start, so the definitions agree.
common:windows --repo_env=BAZEL_WIN32_WINNT=/D_WIN32_WINNT=0x0A00
# Tests and the explorer read data files by their paths in the runfiles tree,
# which Bazel only creates on Windows when asked (it needs permission to
# create symlinks: Developer Mode, or an administrator shell).
build:windows --enable_runfiles
# Required after Xcode reinstall: the old Command Line Tools SDK headers
# have availability annotations that trip up abseil/std::variant/std::optional
# without an explicit minimum OS target. macOS 26 is the actual host OS.
build --macos_minimum_os=14.0
test --test_output=errors

# Bazel 9 removed the native C++ rules. csv-parser's BCR BUILD file (2.3.0,
# the latest release) still uses cc_library without a load(), so autoload it
# from rules_cc. Remove once csv-parser publishes a fixed BCR version.
common --incompatible_autoload_externally=+cc_library

# AddressSanitizer (Linux and macOS): bazel test --config=asan ...
build:asan --copt=-fsanitize=address --copt=-fno-omit-frame-pointer --linkopt=-fsanitize=address
# Only build what the tests need. The GUI deps don't build under ASan on Linux:
# xkbcommon (via glfw) detects strndup with a configure-style check that doesn't
# pass with these flags, so it defines its own, which clashes with glibc's.
test:asan --build_tests_only

# Example for referencing a custom BCR branch:
#query --registry=https://raw.githubusercontent.com/phaedon/bazel-central-registry/implot3d
#build --registry=https://raw.githubusercontent.com/phaedon/bazel-central-registry/implot3d
build --cxxopt=-std=c++20 --cxxopt=-Werror=return-type --copt=-Wsign-compare
# Required after Xcode reinstall: the old Command Line Tools SDK headers
# have availability annotations that trip up abseil/std::variant/std::optional
# without an explicit minimum OS target. macOS 26 is the actual host OS.
build --macos_minimum_os=14.0
test --test_output=errors

# Bazel 9 removed the native C++ rules. csv-parser's BCR BUILD file (2.3.0,
# the latest release) still uses cc_library without a load(), so autoload it
# from rules_cc. Remove once csv-parser publishes a fixed BCR version.
common --incompatible_autoload_externally=+cc_library

# The Emscripten toolchain (used by //wasm:engine) disables C++ exceptions by
# default, but boost.math's interpolators throw. Enable native WebAssembly
# exceptions; host toolchains don't define this feature and ignore it.
build --features=wasm_exceptions
# boost.container (a transitive dependency of boost.math) falls back to Win32
# APIs when it doesn't detect pthreads, as in Emscripten's single-threaded
# build. Emscripten provides no-op pthread mutex stubs, so point it at those.
# The empty value matches boost's own definition, so host builds are unchanged.
build --per_file_copt=.*boost\.container.*@-DBOOST_HAS_PTHREADS=

# AddressSanitizer: bazel test --config=asan ...
build:asan --copt=-fsanitize=address --copt=-fno-omit-frame-pointer --linkopt=-fsanitize=address
# Only build what the tests need. The GUI deps don't build under ASan on Linux:
# xkbcommon (via glfw) detects strndup with a configure-style check that doesn't
# pass with these flags, so it defines its own, which clashes with glibc's.
test:asan --build_tests_only

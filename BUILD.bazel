package(default_visibility = ["//visibility:public"])

# The execution platform for Windows builds with clang-cl (selected in
# .bazelrc): the auto-configured clang-cl toolchain requires this constraint,
# so that it's chosen over MSVC's cl.exe.
platform(
    name = "x64_windows-clang-cl",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
        "@rules_cc//cc/private/toolchain:clang-cl",
    ],
)

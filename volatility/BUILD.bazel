load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "volatility",
    hdrs = ["volatility.h"],
    deps = [
        "//time:timegrid",
        "@eigen",
    ],
)

cc_test(
    name = "volatility_test",
    srcs = ["volatility_test.cpp"],
    deps = [
        ":volatility",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "ssvi",
    hdrs = ["ssvi.h"],
)

cc_test(
    name = "ssvi_test",
    srcs = ["ssvi_test.cpp"],
    deps = [
        ":ssvi",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "dupire_local_vol",
    hdrs = ["dupire_local_vol.h"],
    deps = [
        ":ssvi",
        ":volatility",
    ],
)

cc_test(
    name = "dupire_local_vol_test",
    srcs = ["dupire_local_vol_test.cpp"],
    deps = [
        ":dupire_local_vol",
        ":volatility",
        "@googletest//:gtest_main",
    ],
)
